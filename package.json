{
  "name": "aerotrace",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first UAV mission planner and flight simulator (educational).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "npm run start -w @aerotrace/mobile",
    "dev:api": "npm run dev -w @aerotrace/api",
    "web": "npm run web -w @aerotrace/mobile",
    "ios": "npm run ios -w @aerotrace/mobile",
    "android": "npm run android -w @aerotrace/mobile",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~55.0.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
