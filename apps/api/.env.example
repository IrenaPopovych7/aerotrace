# Copy to .env.local (git-ignored) or export these before starting the API.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (used from issue #24 on).
CORS_ORIGINS=http://localhost:8081
# Enables fault-injection controls. Never true in production.
DEMO_MODE=false
